{
	"name": "select-code-lines-highlighter",
	"version": "0.1.0",
	"description": "Highlight selected lines in fenced code blocks without modifying the code itself.",
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"markdown",
		"code-block",
		"highlight"
	],
	"author": "Jacopo",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.2",
		"@eslint/js": "^9.35.0",
		"@types/node": "^24.3.1",
		"esbuild": "^0.25.9",
		"eslint": "^9.35.0",
		"eslint-plugin-obsidianmd": "0.4.0",
		"globals": "^16.3.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.42.0",
		"vitest": "^3.2.4"
	}
}
